{
  "rewrites": [
    {
      "source": "/api/v1/cupons",
      "destination": "/api/util/cupons"
    },
    {
      "source": "/api/v1/regiao",
      "destination": "/api/util/regiao"
    },
    {
      "source": "/api/v1/proximos",
      "destination": "/api/util/proximos"
    },
    {
      "source": "/api/v1/cnpj",
      "destination": "/api/util/cnpj"
    },
    {
      "source": "/api/versao",
      "destination": "/api/util/versao"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/cadastro",
      "destination": "/cadastro.html"
    },
    {
      "source": "/docs",
      "destination": "/api-docs.html"
    },
    {
      "source": "/adminklm08",
      "destination": "/adminklm08.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/grupo",
      "destination": "/grupo.html"
    },
    {
      "source": "/mercado",
      "destination": "/mercado.html"
    }
  ],
  "crons": [
    {
      "path": "/api/util/limpeza",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/v1/precos.js": {
      "maxDuration": 30
    },
    "api/v1/video.js": {
      "maxDuration": 60
    },
    "api/admin/usuarios.js": {
      "maxDuration": 60
    }
  }
}
